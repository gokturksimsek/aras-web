# ── Sitenin kök adresi (SEO) ──────────────────────────────────────
# Alan adı kesinleşince doldurun: canonical, sitemap, robots, OG, JSON-LD, llms.txt bunu kullanır.
# Boşsa Vercel üretim adresi, yerelde http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# ── İletişim formu e-posta gönderimi ──────────────────────────────
# Bu dosyayı ".env.local" adıyla kopyalayıp değerleri doldurun.
# Vercel'de: Project → Settings → Environment Variables.

# 1) ÖNERİLEN: Gmail SMTP (mesajlar kendi Gmail hesabınızdan size gelir)
#    SMTP_PASS normal Gmail şifreniz DEĞİL, 16 haneli "Uygulama Şifresi"dir:
#    Google Hesabı → Güvenlik → 2 Adımlı Doğrulama (açık olmalı) → Uygulama şifreleri
SMTP_USER=erbakanaras@gmail.com
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# Formun gideceği adres (boşsa lib/site.ts → site.email)
CONTACT_TO_EMAIL=

# 2) Alternatif: Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Hiçbiri tanımlı değilse form, FormSubmit ile tarayıcıdan gönderir
# (ilk mesajda site.email adresine tek seferlik "Activate Form" e-postası gelir).
